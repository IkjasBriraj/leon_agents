# ─── Database & Cache Config ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/agentcraft
REDIS_URL=redis://localhost:6379/0

# ─── LLM Provider (Local Ollama Defaults) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ─── Auth & Security ──────────────────────────────────────────────────────────
# Change these in production!
SECRET_KEY=super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM encryption key for tool secrets (32 bytes base64 encoded)
ENCRYPTION_KEY=enc-key-32bytes-must-be-secure-123456

# ─── Environment Details ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.5
CORS_ORIGINS=["http://localhost:3000"]
